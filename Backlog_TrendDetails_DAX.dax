// =====================================================================
// BACKLOG REDUCTION SUCCESSES - "Trend Details" version
// DAX - presentation only. All numbers come from Power Query.
// No CALCULATE used.
//
// Model setup (no relationships needed):
//   Summary[Metric]          Sort by column -> Summary[MetricOrder]
//   Summary[ReportDateLabel] Sort by column -> Summary[DateOrder]
//
// Page:
//   Slicer  : Summary[ReportDateLabel], single select   (replaces C4)
//   Table   : Metric | As of | Running Reduction | Total Percent Reduced
//   Title   : "Backlog Reduction Successes – By The Numbers"
//   Subtitle: fx -> [Summary Subtitle]
//   Optional line chart: X = Summary[ReportDate], Y = [Aged Pending Cases]
//   (replaces the G:I helper columns: 20343 / 18888 / 17574 ...)
// =====================================================================


Summary Subtitle =
VAR _AsOf  = MAX ( Summary[ReportDate] )
VAR _Since = MAX ( Settings[ReductionSinceDate] )
RETURN
    IF (
        HASONEVALUE ( Summary[ReportDate] ),
        "As of " & FORMAT ( _AsOf, "mmmm d, yyyy" )
            & "   |   Running reduction and percent since "
            & FORMAT ( _Since, "mmmm d, yyyy" ),
        "Select one report date"
    )


// ---- Optional measures for cards / trend chart -----------------------

Aged Pending Cases =
SUMX ( FILTER ( Summary, Summary[MetricOrder] = 1 ), Summary[AsOfValue] )

Running Reduction =
SUMX ( FILTER ( Summary, Summary[MetricOrder] = 1 ), Summary[RunningReductionValue] )

Total Percent Reduced =
SUMX ( FILTER ( Summary, Summary[MetricOrder] = 1 ), Summary[PercentValue] )

Per Agent Caseload =
SUMX ( FILTER ( Summary, Summary[MetricOrder] = 2 ), Summary[AsOfValue] )

BTP Cases Dispositioned =
SUMX ( FILTER ( Summary, Summary[MetricOrder] = 3 ), Summary[RunningReductionValue] )

Agents Used =
MAXX ( FILTER ( Summary, Summary[MetricOrder] = 1 ), Summary[AgentsUsed] )

// Shows "Fallback 373 used" when no staffed pay period was found for the month
Agent Count Note =
VAR _Fallback =
    MAXX ( FILTER ( Summary, Summary[MetricOrder] = 1 ), INT ( Summary[UsedFallback] ) )
RETURN
    IF ( _Fallback = 1, "Fallback " & FORMAT ( Agents Used, "0" ) & " agents used", BLANK () )
